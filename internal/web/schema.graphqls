"UTC timestamp in ISO 8601 format."
scalar Time
"Signed 64-bit integer."
scalar Long

directive @goField(forceResolver: Boolean, name: String, omittable: Boolean) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION

type Query {
 shortURLs(filter: ShortURLFilter): ShortURLPage!
 shortURL(code: String!, domain: String): ShortURL!
 tags(searchTerm: String, page: Int, itemsPerPage: Int): TagPage!
 domains: [Domain!]!
 visitsOverview: VisitOverview!
 visits(filter: VisitFilter): VisitPage!
 orphanVisits(type: String, filter: VisitFilter): VisitPage!
 tagVisits(tag: String!, filter: VisitFilter): VisitPage!
 domainVisits(authority: String!, filter: VisitFilter): VisitPage!
 visitsPerDay(scope: StatsScope): [DayCount!]!
 breakdown(by: String!, scope: StatsScope, limit: Int): [BreakdownCount!]!
 apiKeys: [APIKey!]!
 webhooks: [Webhook!]!
}
type Mutation {
 createShortURL(input: CreateShortURLInput!): ShortURL!
 updateShortURL(code: String!, domain: String, input: UpdateShortURLInput!): ShortURL!
 deleteShortURL(code: String!, domain: String): Boolean!
 setRedirectRules(code: String!, domain: String, rules: [RedirectRuleInput!]!): RedirectRules!
 deleteShortURLVisits(code: String!, domain: String): Long!
 renameTag(oldName: String!, newName: String!): TagRename!
 deleteTags(tags: [String!]!): Long!
 createDomain(domain: String!): Domain!
 updateDomainRedirects(input: DomainRedirectsInput!): Domain!
 deleteDomain(authority: String!): Boolean!
 deleteOrphanVisits: Long!
 createAPIKey(input: CreateAPIKeyInput!): APIKey!
 setAPIKeyEnabled(id: Long!, enabled: Boolean!): IDEnabled!
 deleteAPIKey(id: Long!): Boolean!
 createWebhook(input: CreateWebhookInput!): Webhook!
 setWebhookEnabled(id: Long!, enabled: Boolean!): IDEnabled!
 deleteWebhook(id: Long!): Boolean!
}
input ShortURLFilter {
 searchTerm: String
 tags: [String!]
 tagsMode: String
 group: String
 domain: String
 orderBy: String
 startDate: String
 endDate: String
 excludeMaxVisitsReached: Boolean
 excludePastValidUntil: Boolean
 page: Int
 itemsPerPage: Int
}
input VisitFilter { startDate: String, endDate: String, excludeBots: Boolean, page: Int, itemsPerPage: Int }
input StatsScope { shortCode: String, domain: String, tag: String, orphan: Boolean, startDate: String, endDate: String }
input CreateShortURLInput {
 longUrl: String!
 customSlug: String
 shortCodeLength: Int
 domain: String
 title: String
 tags: [String!]
 group: String
 maxVisits: Long
 validSince: Time
 validUntil: Time
 forwardQuery: Boolean
 crawlable: Boolean
 redirectStatus: Int
 findIfExists: Boolean
}
"Omitted fields stay unchanged. Explicit null clears optional fields."
input UpdateShortURLInput {
 longUrl: String @goField(omittable: true)
 title: String @goField(omittable: true)
 tags: [String!] @goField(omittable: true)
 group: String @goField(omittable: true)
 maxVisits: Long @goField(omittable: true)
 validSince: Time @goField(omittable: true)
 validUntil: Time @goField(omittable: true)
 forwardQuery: Boolean @goField(omittable: true)
 crawlable: Boolean @goField(omittable: true)
 redirectStatus: Int @goField(omittable: true)
}
input RedirectRuleInput { longUrl: String!, conditions: [RuleConditionInput!]! }
input RuleConditionInput { type: String!, matchKey: String, matchValue: String! }
input DomainRedirectsInput { domain: String!, baseUrlRedirect: String, regular404Redirect: String, invalidShortUrlRedirect: String }
input CreateAPIKeyInput { name: String, role: String, domain: String, expiresAt: Time }
input CreateWebhookInput { name: String!, url: String!, events: [String!]! }

type ShortURL {
 shortCode: String!
 shortUrl: String!
 domain: String!
 longUrl: String!
 title: String
 dateCreated: Time!
 tags: [String!]!
 group: String
 meta: ShortURLMeta!
 visitsSummary: VisitsSummary!
 forwardQuery: Boolean!
 crawlable: Boolean!
 redirectStatus: Int!
 visits(filter: VisitFilter): VisitPage! @goField(forceResolver: true)
 redirectRules: RedirectRules! @goField(forceResolver: true)
}
type ShortURLMeta { validSince: Time, validUntil: Time, maxVisits: Long }
type VisitsSummary { total: Long!, nonBots: Long!, bots: Long! }
type Pagination { currentPage: Int!, pagesCount: Int!, itemsPerPage: Int!, itemsInCurrentPage: Int!, totalItems: Long! }
type ShortURLPage { data: [ShortURL!]!, pagination: Pagination! }
type VisitPage { data: [Visit!]!, pagination: Pagination! }
type TagPage { data: [Tag!]!, pagination: Pagination! }
type Tag { tag: String!, shortUrlsCount: Long!, visitsCount: Long! }
type TagRename { oldName: String!, newName: String! }
type RedirectRules { defaultLongUrl: String!, redirectRules: [RedirectRule!]! }
type RedirectRule { longUrl: String!, priority: Int!, conditions: [RuleCondition!]! }
type RuleCondition { type: String!, matchKey: String, matchValue: String! }
type Domain { domain: String!, isDefault: Boolean!, redirects: DomainRedirects! }
type DomainRedirects { baseUrlRedirect: String, regular404Redirect: String, invalidShortUrlRedirect: String }
type VisitOverview { visitsCount: Long!, orphanVisitsCount: Long!, shortUrlsCount: Long!, tagsCount: Long!, botVisitsCount: Long! }
type DayCount { date: String!, count: Long! }
type BreakdownCount { value: String!, count: Long! }
type Visit {
 date: Time!
 referer: String
 userAgent: String
 browser: String
 os: String
 device: String
 potentialBot: Boolean!
 visitedUrl: String
 countryCode: String
 country: String
 city: String
 latitude: Float
 longitude: Float
}
"apiKey is returned only by createAPIKey."
type APIKey { id: Long!, name: String, role: String!, domain: String, enabled: Boolean!, expiresAt: Time, createdAt: Time!, apiKey: String! }
"secret is returned only by createWebhook. Requires webhooks to be enabled."
type Webhook { id: Long!, name: String!, url: String!, events: [String!]!, enabled: Boolean!, createdAt: Time!, secret: String! }
type IDEnabled { id: Long!, enabled: Boolean! }
