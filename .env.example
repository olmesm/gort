# Copy to .env and keep that file private: chmod 600 .env
# Docker Compose reads .env automatically. For uv run goto, export the values
# in your shell first; the application reads process environment variables.

# Local PostgreSQL connection. Compose supplies its own internal connection.
GOTO_DB_CONNECTION=postgresql://localhost/goto
GOTO_DEFAULT_DOMAIN=localhost:8080

# Optional first-run admin password. Empty means generate one in the startup log.
# This setting does not change the password of an existing account.
GOTO_INITIAL_ADMIN_PASSWORD=

# Required by Docker Compose. Set a password and retain it for subsequent starts.
# Generate one with: openssl rand -hex 32
GOTO_POSTGRES_PASSWORD=

# Database used by Python and browser tests. Create it before running the tests.
GOTO_TEST_POSTGRES_DSN=postgresql://localhost/goto_test
